
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Dagavor</title>
<style>
body{font-family:Arial;text-align:center;padding:20px;background:#f5f5f5}
.box{background:white;padding:20px;border-radius:10px}
input{width:90%;padding:12px;margin:10px;border:1px solid #ccc}
button{padding:12px 25px;background:green;color:white;border:none;border-radius:5px}
#resultat{margin-top:20px;font-weight:bold;background:#e8ffe8;padding:15px;word-break:break-all}
</style>
</head>
<body>
<div class="box">
<h2>🛡️ Dagavor</h2>
<p>Colle le code bizarre :</p>
<input id="code" placeholder="Ex: aHR0cHM6Ly9mYWtlLW10bi5jb20=">
<br>
<button onclick="decoder()">Décoder</button>
<div id="resultat"></div>
</div>
<script>
function decoder(){
let c=document.getElementById("code").value;
try{
let d=atob(c);
document.getElementById("resultat").innerHTML="Vrai lien: <br><span style='color:red'>"+d+"</span>";
}catch{
document.getElementById("resultat").innerHTML="❌ Pas valide";
}
}
</script>
</body>
</html>
